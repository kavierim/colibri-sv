targets:
  default:
    filesets:
      - rtl
    tools:
      verilator:
        verilator_options:
          - -Isrc
  sim:
    filesets:
      - rtl
      - sim
    default_tool: verilator
    parameters:
      top_module:
        datatype: str
        default: counter_tb
        description: Testbench module elaborated by this run (one of sim/**/*_tb.sv)
    toplevel: ["${top_module}"]
    tools:
      verilator:
        mode: binary
        verilator_options:
          - --timing
          - --assert
          - -Isrc
          - -Wno-DECLFILENAME
          - -Wno-MULTITOP
